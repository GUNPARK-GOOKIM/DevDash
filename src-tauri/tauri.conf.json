{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "DevDash",
  "version": "1.0.0",
  "identifier": "com.devdash.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DevDash — Fast Native Database GUI",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "DevDash Team",
    "copyright": "Copyright © 2026 DevDash",
    "shortDescription": "Fast, open-source native database GUI client with AI-assisted SQL workflows, git-style staging, and TablePlus ergonomics.",
    "longDescription": "DevDash is a ultra-fast native database client built with Tauri (Rust + React 18). Features git-style diff review, real-time bento telemetry, interactive ERD visualizer, and local/offline AI SQL assistant.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}